    "results = []\n",
    "\n",
    "def check(name, condition, details=\"\"):\n",
    "    results.append({\"проверка\": name, \"результат\": \"пройдена\" if bool(condition) else \"НЕ ПРОЙДЕНА\", \"пояснение\": details})\n",
    "\n",
    "def raises(exc_type, func, *args, **kwargs):\n",
    "    try:\n",
    "        func(*args, **kwargs)\n",
    "    except exc_type:\n",
    "        return True\n",
    "    except Exception:\n",
    "        return False\n",
    "    return False\n",
    "\n",
    "# --- воспроизводимость\n",
    "a1, a2 = gen_A.generate(1000, random_state=42), gen_A.generate(1000, random_state=42)\n",
    "check(\"один seed — один результат\", np.array_equal(a1, a2), \"random_state = 42, два вызова\")\n",
    "check(\"разные seed — разные результаты\", not np.array_equal(gen_A.generate(1000, random_state=1), gen_A.generate(1000, random_state=2)))\n",
    "check(\"random_state=None даёт разные результаты\", not np.array_equal(gen_A.generate(1000), gen_A.generate(1000)))\n",
    "first = gen_A.generate(5, random_state=1); gen_A.generate(100, random_state=2); again = gen_A.generate(5, random_state=1)\n",
    "check(\"вызовы не влияют друг на друга (нет скрытого состояния)\", np.array_equal(first, again))\n",
    "check(\"Generator с тем же seed даёт тот же результат\", np.array_equal(gen_A.generate(50, random_state=np.random.default_rng(42)), gen_A.generate(50, random_state=42)))\n",
    "check(\"результат не зависит от n: первые 5 значений при n = 5 и n = 10 000 совпадают\", np.array_equal(gen_A.generate(5, random_state=7), gen_A.generate(10_000, random_state=7)[:5]))\n",
    "\n",
    "# --- формат результата\n",
    "for label, gen, data in ((\"A\", gen_A, data_A), (\"D\", gen_D, data_D)):\n",
    "    x = gen.generate(100_000, random_state=SEED)\n",
    "    check(f\"{label}: одномерный массив NumPy длины n\", isinstance(x, np.ndarray) and x.ndim == 1 and x.shape == (100_000,))\n",
    "    check(f\"{label}: dtype совпадает с dtype исходных данных\", x.dtype == data.dtype, str(x.dtype))\n",
    "    check(f\"{label}: все значения встречаются в исходных данных\", np.isin(x, data).all())\n",
    "    check(f\"{label}: нет NaN и бесконечностей\", np.isfinite(x).all())\n",
    "    check(f\"{label}: значения целые и неотрицательные\", (x >= 0).all() and (x == np.round(x)).all(), f\"min = {x.min():.0f}, max = {x.max():.0f}\")\n",
    "check(\"n = 0 даёт пустой массив\", gen_A.generate(0, random_state=1).shape == (0,))\n",
    "check(\"n = 1 даёт массив из одного элемента\", gen_A.generate(1, random_state=1).shape == (1,))\n",
    "check(\"n типа numpy.int64 допускается\", gen_A.generate(np.int64(5), random_state=1).shape == (5,))\n",
    "\n",
    "# --- обработка ошибочных n и random_state\n",
    "check(\"отрицательное n → ValueError\", raises(ValueError, gen_A.generate, -1))\n",
    "check(\"дробное n (2.5) → TypeError\", raises(TypeError, gen_A.generate, 2.5))\n",
    "check(\"n в виде строки → TypeError\", raises(TypeError, gen_A.generate, \"5\"))\n",
    "check(\"n = None → TypeError\", raises(TypeError, gen_A.generate, None))\n",
    "check(\"n = True → TypeError\", raises(TypeError, gen_A.generate, True))\n",
    "check(\"отрицательный random_state → ValueError\", raises(ValueError, gen_A.generate, 5, random_state=-1))\n",
    "\n",
    "# --- обработка ошибочных исходных данных\n",
    "check(\"пустые данные → ValueError\", raises(ValueError, EmpiricalCDFGenerator, []))\n",
    "check(\"двумерные данные → ValueError\", raises(ValueError, EmpiricalCDFGenerator, [[1, 2], [3, 4]]))\n",
    "check(\"данные с NaN → ValueError\", raises(ValueError, EmpiricalCDFGenerator, [1.0, np.nan]))\n",
    "check(\"данные с бесконечностью → ValueError\", raises(ValueError, EmpiricalCDFGenerator, [1.0, np.inf]))\n",
    "check(\"строковые данные → TypeError\", raises(TypeError, EmpiricalCDFGenerator, [\"a\", \"b\"]))\n",
    "check(\"данные с None → TypeError\", raises(TypeError, EmpiricalCDFGenerator, [1, None]))\n",
    "check(\"список и Series дают тот же результат, что и массив\",\n",
    "      np.array_equal(EmpiricalCDFGenerator(list(data_A)).generate(20, 1), gen_A.generate(20, 1))\n",
    "      and np.array_equal(EmpiricalCDFGenerator(df[A_COL]).generate(20, 1), gen_A.generate(20, 1)))\n",
    "\n",
    "# --- предварительные вычисления делаются при инициализации\n",
    "gen_copy = EmpiricalCDFGenerator(data_A.copy())\n",
    "before = gen_copy.generate(1000, random_state=5)\n",
    "cdf_before = gen_copy.cdf_.copy()\n",
    "gen_copy.data[:] = 0\n",
    "check(\"generate не пересчитывает распределение (изменение data после инициализации ничего не меняет)\",\n",
    "      np.array_equal(before, gen_copy.generate(1000, random_state=5)))\n",
    "check(\"параметры (cdf_, pmf_) не меняются при генерации\", np.array_equal(cdf_before, gen_copy.cdf_))\n",
    "\n",
    "# --- интерфейс\n",
    "check(\"наследуется от BaseGenerator\", issubclass(EmpiricalCDFGenerator, BaseGenerator))\n",
    "params = list(inspect.signature(EmpiricalCDFGenerator.generate).parameters)\n",
    "check(\"сигнатура generate(self, n, random_state=None)\", params == [\"self\", \"n\", \"random_state\"]\n",
    "      and inspect.signature(EmpiricalCDFGenerator.generate).parameters[\"random_state\"].default is None)\n",
    "\n",
    "# --- соответствие математике\n",
    "rng_t = np.random.default_rng(0)\n",
    "t = rng_t.uniform(-3, 85, 2000)\n",
    "check(\"cdf(x) совпадает с определением через индикатор (доля x_i <= x)\",\n",
    "      np.allclose(gen_A.cdf(t), [(data_A <= v).mean() for v in t]))\n",
    "check(\"cdf: 0 левее минимума и 1 в максимуме и правее\", gen_A.cdf(-1.0) == 0 and gen_A.cdf(data_A.max()) == 1 and gen_A.cdf(1000.0) == 1)\n",
    "check(\"ppf(cdf(s_k)) = s_k для всех значений носителя\", np.array_equal(gen_A.ppf(gen_A.cdf(gen_A.support_)), gen_A.support_))\n",
    "u = rng_t.uniform(1e-9, 1, 5000)\n",
    "idx = np.searchsorted(gen_A.cdf_, u, side=\"left\")\n",
    "prev = np.concatenate(([0.0], gen_A.cdf_))[idx]\n",
    "check(\"ppf(u) = s_k, где F(s_{k-1}) < u <= F(s_k)\", np.all(prev < u) and np.all(gen_A.cdf_[idx] >= u))\n",
    "check(\"ppf(0) = минимум, ppf(1) = максимум\", gen_A.ppf(0.0) == data_A.min() and gen_A.ppf(1.0) == data_A.max())\n",
    "check(\"ppf вне [0, 1] → ValueError\", raises(ValueError, gen_A.ppf, 1.5))\n",
    "check(\"сумма вероятностей pmf_ равна 1, а cdf_[-1] равна 1 точно\", abs(gen_A.pmf_.sum() - 1) < 1e-12 and gen_A.cdf_[-1] == 1.0)\n",
    "\n",
    "report = pd.DataFrame(results)\n",
    "failed = int((report[\"результат\"] != \"пройдена\").sum())\n",
    "print(f\"Проверок: {len(report)}, не пройдено: {failed}\")\n",
    "report.set_index(\"проверка\")"
   ]
