   "source": [
    "def chi2_pvalue(counts, expected, min_expected=5.0):\n",
    "    # объединяем интервалы справа налево, пока ожидаемое число в каждом не станет >= min_expected\n",
    "    obs_bins, exp_bins, acc_o, acc_e = [], [], 0, 0.0\n",
    "    for o, e in zip(counts[::-1], expected[::-1]):\n",
    "        acc_o += o; acc_e += e\n",
    "        if acc_e >= min_expected:\n",
    "            obs_bins.append(acc_o); exp_bins.append(acc_e); acc_o, acc_e = 0, 0.0\n",
    "    if acc_e > 0:\n",
    "        obs_bins[-1] += acc_o; exp_bins[-1] += acc_e\n",
    "    obs, exp = np.array(obs_bins), np.array(exp_bins)\n",
    "    return stats.chi2.sf(((obs - exp) ** 2 / exp).sum(), len(obs) - 1)\n",
    "\n",
    "n_gof, n_seeds = 100_000, 300\n",
    "rows = []\n",
    "for label, gen, data in ((\"A\", gen_A, data_A), (\"D\", gen_D, data_D)):\n",
    "    size = int(data.max()) + 1\n",
    "    p = pmf_vec(data, size)\n",
    "    pvalues = np.array([chi2_pvalue(np.bincount(gen.generate(n_gof, random_state=seed).astype(int), minlength=size), n_gof * p)\n",
    "                        for seed in range(n_seeds)])\n",
    "    rows.append({\"величина\": label, \"выборок\": n_seeds, \"значений в выборке\": n_gof,\n",
    "                 \"доля p < 0,05 (ожидается около 0,05)\": (pvalues < 0.05).mean(),\n",
    "                 \"средний p (ожидается около 0,5)\": pvalues.mean(),\n",
    "                 \"p критерия равномерности p-value\": stats.kstest(pvalues, \"uniform\").pvalue})\n",
    "pd.DataFrame(rows).set_index(\"величина\").round(3)"
   ]
  },
