    "rng_null2 = np.random.default_rng(321)\n",
    "rows = []\n",
    "for label, gen, data in ((\"A\", gen_A, data_A), (\"D\", gen_D, data_D)):\n",
    "    size = int(data.max()) + 1\n",
    "    p = pmf_vec(data, size)\n",
    "    mu, sigma = data.mean(), data.std()\n",
    "    for n in (100, 1_000, N):\n",
    "        counts = rng_null2.multinomial(n, p, size=4000)\n",
    "        tv95 = np.percentile(0.5 * np.abs(counts / n - p).sum(axis=1), 95)\n",
    "        ks95 = np.percentile(np.abs(np.cumsum(counts / n - p, axis=1)).max(axis=1), 95)\n",
    "        tv, ks, z = np.empty(1000), np.empty(1000), np.empty(1000)\n",
    "        for seed in range(1000):\n",
    "            sample = gen.generate(n, random_state=seed)\n",
    "            q = pmf_vec(sample, size)\n",
    "            tv[seed], ks[seed] = tv_distance(p, q), ks_distance(p, q)\n",
    "            z[seed] = (sample.mean() - mu) / (sigma / np.sqrt(n))\n",
    "        rows.append({\"величина\": label, \"n\": n,\n",
    "                     \"доля генераций с TV выше 95%\": (tv > tv95).mean(),\n",
    "                     \"доля генераций с KS выше 95%\": (ks > ks95).mean(),\n",
    "                     \"z: среднее\": z.mean(), \"z: ст. отклонение\": z.std(),\n",
    "                     \"доля |z| > 1,96\": (np.abs(z) > 1.96).mean()})\n",
    "print(\"Ожидается: доли около 0,05; z со средним около 0 и стандартным отклонением около 1\")\n",
    "pd.DataFrame(rows).set_index([\"величина\", \"n\"]).round(3)"
