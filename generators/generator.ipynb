    "def tv_distance(p, q):\n",
    "    return 0.5 * np.abs(p - q).sum()\n",
    "\n",
    "def ks_distance(p, q):\n",
    "    return np.abs(np.cumsum(p) - np.cumsum(q)).max()\n",
    "\n",
    "sizes = [100, 1_000, 10_000, 100_000, 1_000_000]\n",
    "rng_null = np.random.default_rng(123)\n",
    "rows = []\n",
    "for label, gen, data in ((\"A\", gen_A, data_A), (\"D\", gen_D, data_D)):\n",
    "    size = int(data.max()) + 1\n",
    "    p = pmf_vec(data, size)\n",
    "    for n in sizes:\n",
    "        q = pmf_vec(gen.generate(n, random_state=SEED), size)\n",
    "        counts = rng_null.multinomial(n, p, size=300)\n",
    "        null_tv = 0.5 * np.abs(counts / n - p).sum(axis=1)\n",
    "        null_ks = np.abs(np.cumsum(counts / n - p, axis=1)).max(axis=1)\n",
    "        tv, ks = tv_distance(p, q), ks_distance(p, q)\n",
    "        rows.append({\"величина\": label, \"n\": n,\n",
    "                     \"TV\": tv, \"TV ожид. (среднее)\": null_tv.mean(), \"TV ожид. (95%)\": np.percentile(null_tv, 95),\n",
    "                     \"KS\": ks, \"KS ожид. (среднее)\": null_ks.mean(), \"KS ожид. (95%)\": np.percentile(null_ks, 95),\n",
    "                     \"в пределах нормы\": \"да\" if tv <= np.percentile(null_tv, 95) and ks <= np.percentile(null_ks, 95) else \"нет\"})\n",
    "pd.DataFrame(rows).set_index([\"величина\", \"n\"]).round(4)"
   ]
  },
