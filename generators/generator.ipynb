    "# --- повторение для 500 разных seed\n",
    "n_rep, n_each = 500, 5_000\n",
    "rows = []\n",
    "for label, gen in ((\"A\", gen_A), (\"D\", gen_D)):\n",
    "    lb = np.empty(n_rep); runs_p = np.empty(n_rep)\n",
    "    for seed in range(n_rep):\n",
    "        x = gen.generate(n_each, random_state=seed)\n",
    "        lb[seed] = ljung_box_p(x)\n",
    "        runs_p[seed] = runs_test(x)[1]\n",
    "    rows.append({\"величина\": label, \"последовательностей\": n_rep, \"значений в каждой\": n_each,\n",
    "                 \"Льюнг–Бокс: доля p < 0,05\": (lb < 0.05).mean(),\n",
    "                 \"серии: доля p < 0,05\": (runs_p < 0.05).mean()})\n",
    "print(\"Ожидаемая доля отвержений при корректном генераторе: около 0,05\")\n",
    "pd.DataFrame(rows).set_index(\"величина\").round(3)"
