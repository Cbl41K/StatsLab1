    "def acf(x, nlags):\n",
    "    x = np.asarray(x, dtype=float) - np.mean(x)\n",
    "    denom = np.dot(x, x)\n",
    "    return np.array([np.dot(x[:-k], x[k:]) / denom for k in range(1, nlags + 1)])\n",
    "\n",
    "def ljung_box_p(x, lags=20):\n",
    "    n = len(x)\n",
    "    r = acf(x, lags)\n",
    "    q = n * (n + 2) * np.sum(r ** 2 / (n - np.arange(1, lags + 1)))\n",
    "    return stats.chi2.sf(q, lags)\n",
    "\n",
    "def runs_test(x):\n",
    "    x = np.asarray(x, dtype=float)\n",
    "    above = x[x != np.median(x)] > np.median(x)\n",
    "    n1, n2 = above.sum(), (~above).sum()\n",
    "    runs = 1 + np.sum(above[1:] != above[:-1])\n",
    "    mean = 2 * n1 * n2 / (n1 + n2) + 1\n",
    "    var = (mean - 1) * (mean - 2) / (n1 + n2 - 1)\n",
    "    z = (runs - mean) / np.sqrt(var)\n",
    "    return z, 2 * stats.norm.sf(abs(z))\n",
    "\n",
    "# --- одна последовательность из 10 000 значений\n",
    "n_seq, lags_plot = 10_000, 40\n",
    "sequences = {\"A\": gen_A.generate(n_seq, random_state=7), \"D\": gen_D.generate(n_seq, random_state=8)}\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 3.8))\n",
    "rows = []\n",
    "for ax, (label, x) in zip(axes, sequences.items()):\n",
    "    r = acf(x, lags_plot)\n",
    "    band = 1.96 / np.sqrt(n_seq)\n",
    "    ax.bar(np.arange(1, lags_plot + 1), r, color=\"C0\")\n",
    "    ax.axhline(band, color=\"C3\", ls=\"--\"); ax.axhline(-band, color=\"C3\", ls=\"--\")\n",
    "    ax.set_title(f\"{label}: автокорреляция сгенерированной последовательности\"); ax.set_xlabel(\"сдвиг k\"); ax.set_ylabel(\"r_k\")\n",
    "    z, p_runs = runs_test(x)\n",
    "    rows.append({\"последовательность\": f\"{label}, сгенерированная (n = {n_seq})\",\n",
    "                 \"лагов вне полосы (из 40)\": int((np.abs(r) > band).sum()),\n",
    "                 \"Льюнг–Бокс, p\": ljung_box_p(x), \"серии, z\": z, \"серии, p\": p_runs})\n",
    "plt.tight_layout()\n",
    "pd.DataFrame(rows).set_index(\"последовательность\").round(3)"
   ]
  },
