   "source": [
    "def pmf_vec(x, size):\n",
    "    # доля каждого целого значения 0, 1, ..., size-1 в выборке\n",
    "    return np.bincount(x.astype(int), minlength=size) / len(x)\n",
    "\n",
    "gen_sample_A = gen_A.generate(N, random_state=SEED)\n",
    "gen_sample_D = gen_D.generate(N, random_state=SEED + 1)\n",
    "\n",
    "fig, axes = plt.subplots(2, 2, figsize=(14, 8))\n",
    "for row, (label, data, sample, xmax) in enumerate(((\"A: акцепторы\", data_A, gen_sample_A, 25),\n",
    "                                                  (\"D: доноры\", data_D, gen_sample_D, 15))):\n",
    "    size = int(data.max()) + 1\n",
    "    p, q = pmf_vec(data, size), pmf_vec(sample, size)\n",
    "    ks = np.arange(xmax + 1)\n",
    "\n",
    "    ax = axes[row, 0]\n",
    "    ax.bar(ks - 0.2, p[:xmax + 1], width=0.4, color=\"C7\", label=\"исходные данные\")\n",
    "    ax.bar(ks + 0.2, q[:xmax + 1], width=0.4, color=\"C3\", label=\"сгенерированные\")\n",
    "    ax.set_title(f\"{label}: функция вероятности (PMF)\"); ax.set_xlabel(\"значение\"); ax.set_ylabel(\"доля\"); ax.legend()\n",
    "\n",
    "    ax = axes[row, 1]\n",
    "    grid = np.arange(size)\n",
    "    ax.step(grid, np.cumsum(p), where=\"post\", color=\"k\", lw=2.6, label=\"исходные данные\")\n",
    "    ax.step(grid, np.cumsum(q), where=\"post\", color=\"C3\", lw=1.6, ls=\"--\", label=\"сгенерированные\")\n",
    "    ax.set_title(f\"{label}: эмпирическая функция распределения (ECDF)\"); ax.set_xlabel(\"значение\"); ax.set_ylabel(\"F(x)\"); ax.legend()\n",
    "plt.tight_layout()"
   ]
  },
